# Pomelo OAuth configs - https://developers.pomelo.la/api-reference/home/auth
POMELO_BASE_URL=
POMELO_AUDIENCE=
POMELO_CLIENT_ID=
POMELO_CLIENT_SECRET=

# Card ID used to test push provisioning. Example: "crd-12345"
POMELO_CARD_ID=

# Google Pay Merchant ID from the Issuer Console
NEXT_PUBLIC_GOOGLE_PAY_INTEGRATOR_ID=
